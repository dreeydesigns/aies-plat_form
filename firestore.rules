rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    // Role check: checks Firebase Auth Custom Token Claim first, falls back to stored user doc safely
    function hasRole(role) {
      return signedIn() && (
        request.auth.token.role == role || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role)
      );
    }

    function isAiesCentral() {
      return hasRole('aies_central') || hasRole('admin');
    }

    function isStaff() {
      return hasRole('principal') || 
             hasRole('deputy_principal') || 
             hasRole('hod') || 
             hasRole('class_teacher') || 
             isAiesCentral();
    }

    // Tenancy helper: checks institution custom claim or user doc
    function getUserInstitutionId() {
      return request.auth.token.institutionId != null ? 
             request.auth.token.institutionId : 
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              'institutionId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data ? 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId : null);
    }

    function sameInstitution(institutionId) {
      return signedIn() && (
        isAiesCentral() || 
        (institutionId != null && getUserInstitutionId() == institutionId)
      );
    }

    // ==========================================
    // 1. Users Collection
    // ==========================================
    match /users/{userId} {
      allow read: if signedIn();

      // Account documents created by server or self-signup
      allow create: if signedIn() && request.auth.uid == userId;

      // Client may update its OWN non-privileged fields only.
      // role, institutionId, departmentId, classIds, subscriptionTier cannot be modified by client
      allow update: if signedIn() && (
        isAiesCentral() ||
        (request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['displayName', 'photoURL', 'avatar', 'preferences', 'targetTestDate', 'targetScore', 'baselineScore', 'studentNumber', 'linkedParentUid', 'linkedStudentUids', 'linkCode', 'dateOfBirth', 'updatedAt']))
      );

      allow delete: if isAiesCentral();
    }

    // ==========================================
    // 2. School Codes (Admin writes, Authenticated reads)
    // ==========================================
    match /schoolCodes/{codeId} {
      allow read: if signedIn();
      allow create, update, delete: if isAiesCentral();
    }

    // ==========================================
    // 3. Parent Link Requests
    // ==========================================
    match /parentLinkRequests/{reqId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        resource.data.parentEmail == request.auth.token.email || 
        resource.data.studentUid == request.auth.uid || 
        isAiesCentral()
      );
    }

    // ==========================================
    // 4. Institutions & Tenancy Hierarchy
    // ==========================================
    match /institutions/{institutionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAiesCentral();

      match /departments/{departmentId} {
        allow read: if sameInstitution(institutionId);
        allow write: if isAiesCentral() || (sameInstitution(institutionId) && (hasRole('principal') || hasRole('deputy_principal')));
      }

      match /classes/{classId} {
        allow read: if sameInstitution(institutionId);
        allow write: if isAiesCentral() || (sameInstitution(institutionId) && (hasRole('principal') || hasRole('deputy_principal') || hasRole('hod')));
      }
    }

    // ==========================================
    // 5. System Settings & Tiers
    // ==========================================
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAiesCentral();
    }

    match /subscriptionTiers/{tierId} {
      allow read: if true;
      allow write: if isAiesCentral();
    }

    // ==========================================
    // 6. Textbooks & Learning Materials
    // ==========================================
    match /textbooks/{textbookId} {
      allow read: if signedIn();
      allow write: if isAiesCentral();

      match /chapters/{chapterId} {
        allow read: if signedIn();
        allow write: if isAiesCentral();

        match /sections/{sectionId} {
          allow read: if signedIn();
          allow write: if isAiesCentral();
        }
      }
    }

    // ==========================================
    // 7. SAT Diagnostic & Practice Sessions
    // ==========================================
    match /satDiagnosticSessions/{sessionId} {
      allow read, create, update: if signedIn();
      allow delete: if isAiesCentral();
    }

    match /satTestResults/{resultId} {
      allow read, create, update: if signedIn();
      allow delete: if isAiesCentral();
    }

    // Default fallback
    match /{document=**} {
      allow read: if signedIn();
      allow write: if isAiesCentral();
    }
  }
}
